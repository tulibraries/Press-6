  <div class="col pl-5 my-2 pt-3 agency">
  <h3 style="font-size:125%;">
    <%= title_link(@default_agency.title) %>
  </h3>
  <ul class="list-unstyled">
    <% if @default_agency.contact.present? %>
      <li><%= @default_agency.contact %></li>
    <% end %>

    <% if @default_agency.address.present? %>
      <li><%= @default_agency.address %></li>
    <% end %>

    <% if @default_agency.phone.present? %>
      <li><strong>Phone</strong>: <%= sanitize(@default_agency.phone) %> (phone)</li>
    <% end %>

    <% if @default_agency.fax.present? %>
      <li><strong>Fax</strong>: <%= sanitize(@default_agency.fax) %> (fax)</li>
    <% end %>

    <% if @default_agency.email.present? %>
      <li><strong>Email</strong>: <%= sanitize(@default_agency.email) %></li>
    <% end %>

    <% if @default_agency.website.present? %>
      <li><strong>Website</strong>: <%= sanitize(@default_agency.website) %></li>
    <% end %>
  </ul>
</div>